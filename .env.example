# ==========================================
# DevPulse Platform Environment Configuration
# ==========================================

# ------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Render / Local)
# ------------------------------------------
PROJECT_NAME="DevPulse"
SECRET_KEY="replace-with-a-random-secure-production-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Neon / Supabase Free PostgreSQL)
# Example: postgresql://user:password@ep-cool-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite:///./devpulse.db"

# CORS Configuration (Comma-separated list of allowed origins)
# In production, set to your GitHub Pages URL e.g. "https://abhishecodee.github.io"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://abhishecodee.github.io"

# Optional Background Task Queue (Redis / Celery)
REDIS_URL="redis://localhost:6379/0"

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
# Production OAuth Callback URL: https://abhishecodee.github.io/Engineering-Intelligence-Platform/api/auth/callback/github
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"

# Gemini AI Key for Engineering Insights (Optional)
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (GitHub Actions / Local)
# ------------------------------------------
# Production API URL e.g. "https://devpulse-api.onrender.com/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
