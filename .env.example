# DevPulse SaaS Platform Environment Variables

# App & Security
PROJECT_NAME="DevPulse"
SECRET_KEY="devpulse-super-secret-production-key-change-in-prod-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Production Postgres URL:
# DATABASE_URL="postgresql://devpulse:devpulse_password@localhost:5432/devpulse_db"
# Local Development SQLite fallback:
DATABASE_URL="sqlite:///./devpulse.db"

# Redis Cache & Celery
REDIS_URL="redis://localhost:6379/0"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"

# AI / LLM
GEMINI_API_KEY="your-gemini-api-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
